<Window x:Class="Mtdrop.App.NoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="mtdrop"
        Width="384" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        WindowStartupLocation="Manual" UseLayoutRounding="True"
        FontFamily="Segoe UI" FontSize="13">

    <!-- Same card as PromptWindow; the 12 px margin leaves room for the shadow (PromptWindow.ShadowPad). -->
    <Border Margin="12" CornerRadius="8" Padding="16,14,16,14" BorderThickness="1"
            Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource EdgeBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.35" Color="Black"/>
        </Border.Effect>
        <StackPanel>
            <TextBlock x:Name="TitleText" FontSize="14" FontWeight="SemiBold" TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextBrush}"/>
            <TextBlock x:Name="DetailText" Margin="0,4,0,0" TextWrapping="Wrap" MaxHeight="72"
                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextBrush}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="OpenButton" Content="Open folder" Style="{StaticResource AcceptButton}"
                        Margin="0,0,8,0" Click="OnOpenClick" Visibility="Collapsed"/>
                <Button Content="Close" Style="{StaticResource PromptButton}" Click="OnCloseClick"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
