<Window x:Class="Mtdrop.App.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="mtdrop"
        Width="384" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        WindowStartupLocation="Manual" UseLayoutRounding="True"
        FontFamily="Segoe UI" FontSize="13">

    <!-- The 12 px margin leaves room for the shadow; keep it in sync with PromptWindow.ShadowPad. -->
    <Border Margin="12" CornerRadius="8" Padding="16,14,16,14" BorderThickness="1"
            Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource EdgeBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.35" Color="Black"/>
        </Border.Effect>
        <StackPanel>
            <!-- Sender name is untrusted: plain Text only, one line, ellipsis when too long. -->
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Right" Text=" wants to send you a file" FontSize="14" TextWrapping="NoWrap"
                           Foreground="{DynamicResource TextBrush}"/>
                <TextBlock x:Name="NameText" FontSize="14" FontWeight="SemiBold" TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextBrush}"/>
            </DockPanel>
            <TextBlock x:Name="DetailText" Margin="0,4,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource TextBrush}"/>
            <TextBlock Margin="0,4,0,0" FontSize="11" Text="Sender name is not verified"
                       Foreground="{DynamicResource MutedBrush}"/>
            <TextBlock x:Name="CountdownText" Margin="0,10,0,0" FontSize="11"
                       Foreground="{DynamicResource MutedBrush}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button x:Name="DeclineButton" Content="Decline" Style="{StaticResource PromptButton}"
                        Margin="0,0,8,0" Click="OnDeclineClick"/>
                <Button x:Name="AcceptButton" Content="Accept" Style="{StaticResource AcceptButton}"
                        Click="OnAcceptClick"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
