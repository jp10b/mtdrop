<Window x:Class="Mtdrop.App.ReceiverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="mtdrop - send"
        Width="384" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="True" Topmost="True"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        FontFamily="Segoe UI" FontSize="13">

    <!-- Same card as PromptWindow / NoticeWindow. Opened by the user's own "Send" action, so it may take focus. -->
    <Border Margin="12" CornerRadius="8" Padding="16,14,16,14" BorderThickness="1"
            Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource EdgeBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.35" Color="Black"/>
        </Border.Effect>
        <StackPanel>
            <TextBlock x:Name="TitleText" FontSize="14" FontWeight="SemiBold" TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextBrush}"/>
            <TextBlock x:Name="StatusText" Margin="0,4,0,10" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
            <StackPanel x:Name="Receivers"/>
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                       Text="Only choose a device you know: other people's iPhones nearby can appear here too. The iPhone needs AirDrop set to Everyone for 10 Minutes and its screen on."/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Cancel" Style="{StaticResource PromptButton}" Click="OnCancelClick"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
