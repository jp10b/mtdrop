<Project Sdk="Microsoft.NET.Sdk">

  <!-- The elevated mtdrop service (ADR-0004): runs receive sessions, always gives the Wi-Fi card back. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- LibraryImport (CfgMgr32, newdev, job objects) generates unsafe marshalling code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>mtdrop-service</AssemblyName>
    <RootNamespace>Mtdrop.Service</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mtdrop.Control\Mtdrop.Control.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Mtdrop.Service.Tests" />
  </ItemGroup>

</Project>
